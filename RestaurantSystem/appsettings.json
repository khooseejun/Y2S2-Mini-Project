{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;AttachDbFilename=|DataDirectory|\\DB.mdf;Database=RestaurantSystemDB;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  // ==========================================================================
  // Email (SMTP) settings — password recovery only.
  //
  // This file is SHARED, so it must not contain real credentials. It only
  // carries the non-secret defaults below.
  //
  // To enable password-recovery emails on your machine, put your own sender
  // account into the GIT-IGNORED file `appsettings.Development.Local.json`
  // (see `.gitignore`), which overrides these values:
  //
  //   {
  //     "EmailSettings": {
  //       "SenderEmail": "you@example.com",
  //       "SenderPassword": "your-app-password"
  //     }
  //   }
  //
  // Leave them blank and the app still runs normally — AccountController
  // catches send failures and shows "We couldn't send the email right now."
  // ==========================================================================
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "FFG Restaurant",
    "SenderEmail": "",
    "SenderPassword": ""
  }
}
